# Supabase Configuration (Free Tier)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Security & Hashing Salt (Enter any long, random string)
HASH_SALT=make_this_a_very_long_and_secure_random_string_xyz789

# Site URL for canonical URLs, Open Graph, and sitemap
NEXT_PUBLIC_SITE_URL=https://nusukkey.com

# Nusuk App Deep Link Template (OPTIONAL)
# Format: nusuk://competition?code={code}
# If left empty, the "Open in Nusuk" button will be safely hidden and only "Copy" will be displayed.
# WARNING: Only set this once you have verified the exact deep link scheme from the official Nusuk app.
NUSUK_DEEP_LINK_TEMPLATE=
NEXT_PUBLIC_NUSUK_DEEP_LINK_TEMPLATE=
