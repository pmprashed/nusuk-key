# Supabase Configuration (Free Tier)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Security & Hashing Salt (Enter any long, random string)
HASH_SALT=make_this_a_very_long_and_secure_random_string_xyz789

# Site URL for canonical URLs, Open Graph, and sitemap
NEXT_PUBLIC_SITE_URL=https://nusukkey.com

# Nusuk App Deep Link (confirmed from official Nusuk service)
# Format: https://services.nusuk.sa/app?p=27&id={code}
# The {code} placeholder is dynamically replaced with each key (e.g., NG-CXEVbXwR).
NUSUK_DEEP_LINK_TEMPLATE=https://services.nusuk.sa/app?p=27&id={code}
NEXT_PUBLIC_NUSUK_DEEP_LINK_TEMPLATE=https://services.nusuk.sa/app?p=27&id={code}
